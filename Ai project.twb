      <aliases enabled='yes' />
      <column datatype='integer' name='[Ai Salary Premium Pct (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='-1' formula='[ai_salary_premium_pct]' peg='0' size='0.8' />
      </column>
      <column caption='Remote jobs ' datatype='real' name='[Calculation_0946792614522881]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [remote_work]=&apos;Fully Remote&apos; THEN 1 ELSE 0 END) / COUNTD([job_id])' />
      </column>
      <column caption='posting month' datatype='string' name='[Calculation_0946796112314372]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [posting_month]&#10;WHEN 1 THEN &quot;January&quot;&#10;WHEN 2 THEN &quot;February&quot;&#10;WHEN 3 THEN &quot;March&quot;&#10;WHEN 4 THEN &quot;April&quot;&#10;WHEN 5 THEN &quot;May&quot;&#10;WHEN 6 THEN &quot;June&quot;&#10;WHEN 7 THEN &quot;July&quot;&#10;WHEN 8 THEN &quot;August&quot;&#10;WHEN 9 THEN &quot;September&quot;&#10;WHEN 10 THEN &quot;October&quot;&#10;WHEN 11 THEN &quot;November&quot;&#10;WHEN 12 THEN &quot;December&quot;&#10;END' />
      </column>
      <column caption='LLM Role' datatype='string' name='[Calculation_0946796113653765]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [is_llm_role] = 1 THEN &quot;LLM Role&quot; ELSE &quot;Non-LLM Role&quot; END' />
      </column>
      <column caption='Years Of Experience (bin)' datatype='integer' name='[Years Of Experience (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='0' formula='[years_of_experience]' peg='0' size='2' />
      </column>
      <column caption='Clean_ai_jobs.csv' datatype='table' name='[__tableau_internal_object_id__].[Clean_ai_jobs.csv_C66CF30A63054601B38C71105D2065A2]' role='measure' type='quantitative' />
